{
  "name": "otoshi-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:prerender",
    "build:prerender": "vite build --ssr src/entry-prerender.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@premiummg/ui": "^0.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^7.18.4",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/node": "^13.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}
