# Copy to .env.local (gitignored) for `npm run dev`. On Vercel, set the same
# names under Project Settings -> Environment Variables instead.

# Registration emails (https://resend.com)
RESEND_API_KEY=

# Square - SANDBOX values first (Developer Dashboard -> your app -> Credentials)
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Cloudflare Turnstile captcha (free). Both set = required on /register.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: override who receives registration emails.
REGISTRATION_TO=

# Optional: pin the public site URL Square sends families back to after
# paying (default: derived from the request).
SITE_URL=
